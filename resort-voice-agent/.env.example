# ===== Obrigatório =====
# URL público HTTPS (sem barra no fim). Tem de ser exatamente o URL que o Twilio chama.
PUBLIC_BASE_URL=https://atendia.exemplo.pt

# Postgres. No Render é preenchido automaticamente pelo blueprint.
DATABASE_URL=postgres://utilizador:password@host:5432/atendia
# DATABASE_SSL=true   # só se a base de dados exigir TLS numa ligação externa

# Chave que cifra os dados pessoais e os segredos dos clientes. 64 caracteres hex:
#   openssl rand -hex 32
# Guarde-a num gestor de passwords. Se a perder ou alterar, os dados cifrados ficam ilegíveis.
MASTER_ENCRYPTION_KEY=

# Segredo para os tokens das chamadas (>= 32 caracteres): openssl rand -hex 32
SESSION_SIGNING_SECRET=

# Conta de administrador criada no primeiro arranque.
# Sem ADMIN_INITIAL_PASSWORD, é gerada uma temporária e mostrada uma vez nos logs.
ADMIN_EMAIL=
# ADMIN_INITIAL_PASSWORD=

ANTHROPIC_API_KEY=
TWILIO_AUTH_TOKEN=

# ===== Opcional =====
BRAND_NAME=Atendia
# CONTACT_EMAIL=ola@atendia.pt
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
RETENTION_DAYS=90
MAX_CONCURRENT_CALLS=50
MAX_CALL_DURATION_SECONDS=900
LOG_LEVEL=info
# Só para docker-compose:
# POSTGRES_PASSWORD=
