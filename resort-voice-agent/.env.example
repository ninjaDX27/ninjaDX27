# ===== Obrigatório =====
# URL público HTTPS do serviço (sem barra no fim). Tem de ser EXATAMENTE o URL
# configurado no Twilio, senão a validação de assinatura falha.
PUBLIC_BASE_URL=https://voice.exemplo-resort.pt

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Auth Token da conta Twilio (Console > Account > API keys & tokens)
TWILIO_AUTH_TOKEN=

# Segredo aleatório >= 32 caracteres. Gerar com: openssl rand -hex 32
SESSION_SIGNING_SECRET=

# Número da receção para transferências (formato E.164)
RECEPTION_PHONE_NUMBER=+351210000000

# ===== Opcional =====
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
RESORT_CONFIG_PATH=config/resort.json

CLAUDE_MODEL=claude-opus-5-5
# low = respostas mais rápidas ao telefone (recomendado); medium/high = mais raciocínio
CLAUDE_EFFORT=low
CLAUDE_REFUSAL_FALLBACK=true

# Disponibilidade: "static" (preços indicativos do ficheiro) ou "http" (API do PMS)
AVAILABILITY_PROVIDER=static
# PMS_API_URL=https://pms.exemplo.pt/api
# PMS_API_TOKEN=

# Para onde vão os pedidos de reserva (CRM, n8n, Make, PMS). Assinado com HMAC-SHA256.
# RESERVATION_WEBHOOK_URL=https://n8n.exemplo.pt/webhook/reservas
# RESERVATION_WEBHOOK_SECRET=   # openssl rand -hex 32

MAX_CONCURRENT_CALLS=20
MAX_CALL_DURATION_SECONDS=900
MAX_TURNS_PER_CALL=60
MAX_UTTERANCE_CHARS=1500
LLM_TIMEOUT_MS=30000
TRUST_PROXY=1
