; Ligação ao operador SIP (gerado no arranque a partir das variáveis de ambiente).

[global]
type=global
user_agent=Atendia

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=${PUBLIC_IP}
external_signaling_address=${PUBLIC_IP}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[trunk-auth]
type=auth
auth_type=userpass
username=${SIP_USERNAME}
password=${SIP_PASSWORD}

[trunk-reg]
type=registration
outbound_auth=trunk-auth
server_uri=sip:${SIP_HOST}
client_uri=sip:${SIP_USERNAME}@${SIP_HOST}
contact_user=${SIP_USERNAME}
retry_interval=60
forbidden_retry_interval=600
expiration=300

[trunk]
type=aor
contact=sip:${SIP_HOST}
qualify_frequency=60

[trunk]
type=endpoint
transport=transport-udp
context=from-trunk
disallow=all
allow=alaw,ulaw
outbound_auth=trunk-auth
aors=trunk
from_user=${SIP_USERNAME}
from_domain=${SIP_HOST}
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

; Só aceita chamadas vindas do operador (sem endpoint anónimo).
[trunk-identify]
type=identify
endpoint=trunk
match=${SIP_HOST}
